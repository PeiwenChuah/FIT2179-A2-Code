{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "data": { "url": "data/staff_across_years.csv" },
  "transform": [
    { "calculate": "toNumber(datum.DIM_TIME)", "as": "year" },
    { "calculate": "toNumber(datum.RATE_PER_10000_N)", "as": "rate" },
    {
      "calculate": "datum.IND_NAME === 'Nurse (per 10,000 population)' ? 'Nurse' : datum.IND_NAME === 'Doctor (per 10,000 population)' ? 'Doctor' : 'Pharmacist'",
      "as": "type_label"
    }
  ],
  "mark": { "type": "line", "point": true, "tooltip": true },

  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "titleFontSize": 14,
        "titleFontWeight": "normal",
        "titlePadding": 10,
        "grid": false,
        "format": "d"
      }
    },

    "y": {
      "field": "rate",
      "type": "quantitative",
      "title": "Professionals per 10,000 population",
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 14,
        "titleFontWeight": "normal",
        "titlePadding": 10,
        "gridColor": "#eef0f3",
        "gridOpacity": 1,
        "format": ".1f"
      }
    },

    "color": {
      "field": "type_label",
      "type": "nominal",
      "title": "Profession",
      "scale": {
        "domain": ["Doctor", "Nurse", "Pharmacist"],
        "range": ["#1a6b9a", "#4dab91", "#e07b39"]
      },

      "legend": {
        "orient": "top-left",
        "titleFontSize": 14,
        "labelFontSize": 14,
        "symbolSize": 100,
        "offset": 8,

        "titleFontWeight": "bold",
        "labelFontWeight": "normal"
      }
    }
  },

  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": { "domainColor": "#ccc", "tickColor": "#ccc" },
    "line": { "strokeWidth": 2.5 },
    "point": { "filled": true, "size": 50 }
  }
}