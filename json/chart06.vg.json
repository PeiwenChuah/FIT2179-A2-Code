{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Number of Inpatient and Outpatient Visits by Sector",
    "fontSize": 16,
    "anchor": "start",
    "offset": 12
  },
  "width": 700,
  "height": 420,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "values": [
      { "ServiceType": "Inpatient",  "sector_label": "MOH Public",     "count": 2712916  },
      { "ServiceType": "Inpatient",  "sector_label": "Non-MOH Public", "count": 197530   },
      { "ServiceType": "Inpatient",  "sector_label": "Private",        "count": 1359910  },
      { "ServiceType": "Outpatient", "sector_label": "MOH Public",     "count": 65841887 },
      { "ServiceType": "Outpatient", "sector_label": "Non-MOH Public", "count": 3188026  },
      { "ServiceType": "Outpatient", "sector_label": "Private",        "count": 3629124  }
    ]
  },
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "ServiceType",
      "type": "nominal",
      "title": null,
      "sort": ["Inpatient", "Outpatient"],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13
      }
    },
    "xOffset": {
      "field": "sector_label",
      "type": "nominal",
      "sort": ["MOH Public", "Non-MOH Public", "Private"]
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of Visits",
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titleFontWeight": "normal",
        "titlePadding": 10,
        "labelExpr": "datum.value >= 1000000 ? format(datum.value / 1000000, '.0f') + 'M' : datum.value >= 1000 ? format(datum.value / 1000, '.0f') + 'K' : datum.value",
        "gridColor": "#e8e8e8",
        "gridOpacity": 0.8
      }
    },
    "color": {
      "field": "sector_label",
      "type": "nominal",
      "title": "Sector",
      "sort": ["MOH Public", "Non-MOH Public", "Private"],
      "scale": {
        "domain": ["MOH Public", "Non-MOH Public", "Private"],
        "range": ["#185FA5", "#1D9E75", "#EF9F27"]
      },
      "legend": {
        "orient": "top-left",
        "titleFontSize": 12,
        "labelFontSize": 12,
        "symbolSize": 120,
        "offset": 10
      }
    },
    "tooltip": [
      { "field": "ServiceType",  "type": "nominal",      "title": "Service Type" },
      { "field": "sector_label", "type": "nominal",      "title": "Sector" },
      { "field": "count",        "type": "quantitative", "title": "Number of Visits", "format": "," }
    ]
  },
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    },
    "font": "system-ui, -apple-system, sans-serif"
  }
}