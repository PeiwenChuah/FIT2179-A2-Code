{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Number of Inpatient and Outpatient Visits by Sector",
    "fontSize": 16,
    "anchor": "start",
    "offset": 12
  },
  "hconcat": [
    {
      "title": {
        "text": "Inpatient",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "#444"
      },
      "width": 300,
      "height": 380,
      "data": { "url": "data/Inpatient and Outpatient.csv" },
      "transform": [
        { "calculate": "toNumber(datum.Number)", "as": "count" },
        { "calculate": "datum.Sector === 'MOH_Public' ? 'MOH Public' : datum.Sector === 'Non_MOH_Public' ? 'Non-MOH Public' : 'Private'", "as": "sector_label" },
        { "filter": "datum.ServiceType === 'Inpatient'" }
      ],
      "mark": { "type": "bar", "tooltip": true },
      "encoding": {
        "x": {
          "field": "sector_label",
          "type": "nominal",
          "sort": { "field": "count", "order": "descending" },
          "title": "Sector",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 10
          }
        },
        "y": {
          "field": "count",
          "type": "quantitative",
          "title": "Number of Visits",
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "labelExpr": "datum.value >= 1000000 ? format(datum.value / 1000000, '.1f') + 'M' : datum.value >= 1000 ? format(datum.value / 1000, '.0f') + 'K' : datum.value",
            "gridColor": "#e8e8e8",
            "gridOpacity": 0.8
          }
        },
        "color": {
          "field": "sector_label",
          "type": "nominal",
          "sort": { "field": "count", "order": "descending" },
          "scale": {
            "domain": ["MOH Public", "Non-MOH Public", "Private"],
            "range": ["#185FA5", "#1D9E75", "#EF9F27"]
          },
          "legend": {
            "title": "Sector",
            "titleOrient": "left",
            "orient": "top",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 12,
            "symbolSize": 120,
            "padding": 5,
            "offset": 8
          }
        },
        "tooltip": [
          { "field": "sector_label", "type": "nominal",      "title": "Sector" },
          { "field": "count",        "type": "quantitative", "title": "Inpatient Visits", "format": "," }
        ]
      }
    },
    {
      "title": {
        "text": "Outpatient",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "#444"
      },
      "width": 300,
      "height": 380,
      "data": { "url": "data/Inpatient and Outpatient.csv" },
      "transform": [
        { "calculate": "toNumber(datum.Number)", "as": "count" },
        { "calculate": "datum.Sector === 'MOH_Public' ? 'MOH Public' : datum.Sector === 'Non_MOH_Public' ? 'Non-MOH Public' : 'Private'", "as": "sector_label" },
        { "filter": "datum.ServiceType === 'Outpatient'" }
      ],
      "mark": { "type": "bar", "tooltip": true },
      "encoding": {
        "x": {
          "field": "sector_label",
          "type": "nominal",
          "sort": { "field": "count", "order": "descending" },
          "title": "Sector",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 10
          }
        },
        "y": {
          "field": "count",
          "type": "quantitative",
          "title": "Number of Visits",
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "labelExpr": "datum.value >= 1000000 ? format(datum.value / 1000000, '.0f') + 'M' : datum.value >= 1000 ? format(datum.value / 1000, '.0f') + 'K' : datum.value",
            "gridColor": "#e8e8e8",
            "gridOpacity": 0.8
          }
        },
        "color": {
          "field": "sector_label",
          "type": "nominal",
          "sort": { "field": "count", "order": "descending" },
          "scale": {
            "domain": ["MOH Public", "Non-MOH Public", "Private"],
            "range": ["#185FA5", "#1D9E75", "#EF9F27"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "sector_label", "type": "nominal",      "title": "Sector" },
          { "field": "count",        "type": "quantitative", "title": "Outpatient Visits", "format": "," }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    },
    "font": "system-ui, -apple-system, sans-serif"
  }
}