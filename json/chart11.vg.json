{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Budget vs Actual Spending by Programme in 2024",
    "fontSize": 16,
    "anchor": "start",
    "offset": 12
  },
  "width": 700,
  "height": 420,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "data": { "url": "data/budget allocation by programme 2024.csv" },
  "transform": [
    {
      "calculate": "toNumber(datum.Budget)",
      "as": "budget_val"
    },
    {
      "fold": ["Budget", "Actual_Spending"],
      "as": ["type", "amount"]
    },
    {
      "calculate": "datum.type === 'Actual_Spending' ? 'Actual Spending' : 'Budget'",
      "as": "type_label"
    },
    {
      "calculate": "toNumber(datum.amount)",
      "as": "amount"
    }
  ],
  "mark": { "type": "bar", "tooltip": true },
  "encoding": {
    "x": {
      "field": "Programme",
      "type": "nominal",
      "title": "Programme",
      "sort": { "field": "budget_val", "op": "max", "order": "descending" },
      "axis": {
        "labelAngle": -30,
        "labelFontSize": 11,
        "labelLimit": 120,
        "titleFontSize": 13,
        "titleFontWeight": "normal",
        "titlePadding": 10
      }
    },
    "xOffset": {
      "field": "type_label",
      "type": "nominal",
      "sort": ["Budget", "Actual Spending"]
    },
    "y": {
      "field": "amount",
      "type": "quantitative",
      "title": "Amount (RM)",
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titleFontWeight": "normal",
        "titlePadding": 10,
        "labelExpr": "datum.value >= 1000000000 ? format(datum.value / 1000000000, '.1f') + 'B' : datum.value >= 1000000 ? format(datum.value / 1000000, '.0f') + 'M' : datum.value >= 1000 ? format(datum.value / 1000, '.0f') + 'K' : datum.value",
        "gridColor": "#e8e8e8",
        "gridOpacity": 0.8
      }
    },
    "color": {
      "field": "type_label",
      "type": "nominal",
      "title": "Type",
      "sort": ["Budget", "Actual Spending"],
      "scale": {
        "domain": ["Budget", "Actual Spending"],
        "range": ["#185FA5", "#EF9F27"]
      },
      "legend": {
        "title": "Type",
        "titleOrient": "left",
        "orient": "top",
        "direction": "horizontal",
        "titleFontSize": 12,
        "labelFontSize": 12,
        "symbolSize": 120,
        "padding": 5,
        "offset": 8
      }
    },
    "tooltip": [
      { "field": "Programme",  "type": "nominal",      "title": "Programme" },
      { "field": "type_label", "type": "nominal",      "title": "Type" },
      { "field": "amount",     "type": "quantitative", "title": "Amount (RM)", "format": "," }
    ]
  },
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    },
    "font": "system-ui, -apple-system, sans-serif"
  }
}