{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Healthcare Staff by Type in Malaysia (2014–2022)",
    "fontSize": 16,
    "anchor": "start",
    "offset": 12
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/healthcare_staff.csv"
  },
  "transform": [
    {
      "calculate": "year(toDate(datum.date))",
      "as": "year"
    },
    {
      "calculate": "toNumber(datum.staff)",
      "as": "staff_num"
    },
    {
      "calculate": "datum.type === 'pharmacist' ? 'Pharmacist' : datum.type === 'nurse' ? 'Nurse' : datum.type === 'doctor' ? 'Doctor' : 'Dentist'",
      "as": "type_label"
    }
  ],
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titleFontWeight": "normal",
        "titlePadding": 10
      }
    },
    "y": {
      "field": "staff_num",
      "type": "quantitative",
      "title": "Number of Staff",
      "stack": "zero",
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titleFontWeight": "normal",
        "titlePadding": 10,
        "format": ",",
        "formatType": "number",
        "labelExpr": "format(datum.value, ',')",
        "gridColor": "#e8e8e8",
        "gridOpacity": 0.8
      }
    },
    "color": {
      "field": "type_label",
      "type": "nominal",
      "title": "Staff type",
      "scale": {
        "domain": ["Nurse", "Doctor", "Dentist", "Pharmacist"],
        "range": ["#185FA5", "#1D9E75", "#EF9F27", "#E41A1C"]
      },
      "legend": {
        "orient": "top-left",
        "titleFontSize": 12,
        "labelFontSize": 12,
        "symbolSize": 120,
        "offset": 10
      }
    },
    "order": {
      "field": "staff_num",
      "aggregate": "sum",
      "sort": "descending"
    },
    "tooltip": [
      { "field": "year", "type": "ordinal", "title": "Year" },
      { "field": "type_label", "type": "nominal", "title": "Staff type" },
      { "field": "staff_num", "type": "quantitative", "title": "Number of Staff", "format": "," }
    ]
  },
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    },
    "font": "system-ui, -apple-system, sans-serif"
  }
}