{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart of hospitalisation cause ranks in Malaysia, 2022-2024",
  "width": 880,
  "height": 520,
  "data": {
    "url": "data/malaysia_hospitalisation_causes.csv"
  },

  "title": {
    "text": "Top 10 Leading Hospitalisation Causes (2022 to 2024)",
    "fontSize": 16,
    "anchor": "start",
    "offset": 12
    },

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "strokeCap": "round"
      },

      "encoding": {
        "x": {
          "field": "year",
          "title": "Year",
          "type": "ordinal",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 10
          }
        },

        "y": {
          "field": "rank",
          "title": "Rank",
          "type": "quantitative",
          "scale": { "reverse": true, "domain": [1, 10] },
          "axis": {
            "tickMinStep": 1,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "grid": false
          }
        },

        "color": {
          "field": "cause_short",
          "type": "nominal",
          "scale": {
            "range": [
              "#e41a1c", "#377eb8", "#4daf4a", "#984ea3",
              "#ff7f00", "#ffff33", "#a65628", "#f781bf",
              "#00a6ca", "#00cc99", "#d95f02", "#7570b3",
              "#8dd3c7", "#fb8072", "#80b1d3", "#b3de69"
            ]
          },
          "legend": null
        },

        "detail": {
          "field": "cause_short"
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 80,
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "rank", "type": "quantitative" },

        "color": {
          "field": "cause_short",
          "type": "nominal",
          "scale": {
            "range": [
              "#e41a1c", "#377eb8", "#4daf4a", "#984ea3",
              "#ff7f00", "#ffff33", "#a65628", "#f781bf",
              "#00a6ca", "#00cc99", "#d95f02", "#7570b3",
              "#8dd3c7", "#fb8072", "#80b1d3", "#b3de69"
            ]
          },
          "legend": null
        },

        "tooltip": [
          { "field": "cause_short", "title": "Disease" },
          { "field": "year", "title": "Year" },
          { "field": "rank", "title": "Rank" },
          { "field": "percentage", "title": "Percentage", "format": ".2f" }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontWeight": 500,
        "dy": -10,
        "align": "center",
        "baseline": "bottom",
        "fill": "#000000"
      },

      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "rank", "type": "quantitative" },
        "text": { "field": "cause_short", "type": "nominal" }
      }
    }
  ],

  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },

    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    },

    "font": "system-ui, -apple-system, sans-serif"
  }
}