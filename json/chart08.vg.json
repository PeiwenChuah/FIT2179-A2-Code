{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart of hospitalisation cause ranks in Malaysia, 2022-2024",

  "width": 880,
  "height": 520,

  "data": {
    "url": "data/malaysia_hospitalisation_causes.csv"
  },

  "title": {
    "text": "Rank Changes of Leading Hospitalisation Causes (2022 to 2024)",
    "fontSize": 16,
    "anchor": "start",
    "offset": 12,
    "subtitle": "Lower rank = higher hospitalisation burden | Lines connect same disease across years"
  },

  "layer": [
    {
      "mark": {
        "type": "line",
        "point": false,
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 10
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": "Rank",
          "scale": {
            "reverse": true,
            "domain": [1, 10]
          },
          "axis": {
            "tickMinStep": 1,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "grid": false 
          }
        },
        "color": {
          "field": "cause_short",
          "type": "nominal",
          "title": "Disease Category",
          "legend": {
            "orient": "top-left",
            "titleFontSize": 12,
            "labelFontSize": 12,
            "symbolSize": 120,
            "offset": 10
          }
        },
        "detail": {
          "field": "cause_short",
          "type": "nominal"
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 80,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "rank", "type": "quantitative"},
        "color": {
          "field": "cause_short",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {"field": "cause_short", "title": "Disease"},
          {"field": "year", "title": "Year"},
          {"field": "rank", "title": "Rank"},
          {"field": "percentage", "title": "Percentage (%)", "format": ".2f"}
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontWeight": 500,
        "dy": -10,
        "align": "center",
        "baseline": "bottom",
        "fill": "#1f2937",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "rank", "type": "quantitative"},
        "text": {"field": "cause_short", "type": "nominal"}
      }
    }
  ],

  "config": {
    "background": "transparent", 
    "view": { "stroke": "transparent" },

    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    },

    "legend": {
      "symbolType": "circle"
    },

    "font": "system-ui, -apple-system, sans-serif"
  }
}