{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 412,
  "projection": {"type": "mercator"},
  "layer": [

    {
      "data": {
        "url": "json/neighbour.topojson",
        "format": {"type": "topojson", "feature": "selection"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f5f5f5",
        "stroke": "#e2e2e2",
        "strokeWidth": 0.5
      }
    },

    {
      "data": {
        "url": "json/neighbour.topojson",
        "format": {"type": "topojson", "feature": "malaysia.state"}
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {"url": "data/doctor_map.csv"},
            "key": "state",
            "fields": ["doctors_per_10000"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "doctors_per_10000",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [15, 19, 23, 30, 60],
            "range": ["#d6e8f5", "#9bbfd9", "#5a96bd", "#2a6899", "#1a3a5c", "#0d1f38"]
          },
          "legend": {
            "title": "Doctors per 10,000 population",
            "orient": "right",
            "direction": "vertical",
            "labelFontSize": 14,
            "titleFontSize": 14,
            "labelLimit": 0,
            "titleLimit": 0,
            "labelColor": "#1a2430",
            "titleColor": "#1a2430"
          }
        },
        "tooltip": [
          { "field": "properties.name", "type": "nominal", "title": "State" },
          { "field": "doctors_per_10000", "type": "quantitative", "title": "Doctors per 10,000 population", "format": ".1f" }
        ]
      }
    },

    {
      "data": {
        "values": [
          {"state": "Kuala Lumpur", "lon1": 100.385522, "lat1": 3.132668, "lon2": 101.6951, "lat2": 3.1483},
          {"state": "Putrajaya", "lon1": 100.583810, "lat1": 2.905202, "lon2": 101.6885, "lat2": 2.9394},
          {"state": "Selangor", "lon1": 100.518843, "lat1": 3.370843, "lon2": 101.4010, "lat2": 3.3789},
          {"state": "Pulau Pinang", "lon1": 99.609136, "lat1": 5.599600, "lon2": 100.3283, "lat2": 5.3678},
          {"state": "Negeri Sembilan", "lon1": 100.896697, "lat1": 2.514112, "lon2": 102.1461, "lat2": 2.7526},
          {"state": "Melaka", "lon1": 101.757084, "lat1": 2.222282, "lon2": 102.3183, "lat2": 2.2474}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b2309",
        "opacity": 0.8,
        "strokeWidth": 1.0
      },
      "encoding": {
        "longitude": {"field": "lon1", "type": "quantitative"},
        "latitude": {"field": "lat1", "type": "quantitative"},
        "longitude2": {"field": "lon2"},
        "latitude2": {"field": "lat2"}
      }
    },

    {
      "data": {"url": "data/state_info.csv"},
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "normal",
        "fill": "white",
        "stroke": "white",
        "strokeWidth": 2.5,
        "strokeJoin": "round",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "state", "type": "nominal"}
      }
    },

    {
      "data": {"url": "data/state_info.csv"},
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "normal",
        "fill": "black",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "state", "type": "nominal"}
      }
    },

    {
      "data": {
        "values": [
          {"longitude": 111.8, "latitude": 7.1, "label": "Sabah & Sarawak"},
          {"longitude": 99.2,  "latitude": 1.75, "label": "Selangor, KL & Putrajaya"},
          {"longitude": 102.9, "latitude": 7.1, "label": "Northern Peninsular Malaysia"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "fill": "#7a2e0e",
        "baseline": "middle",
        "align": "left"
      },
      "encoding": {
        "longitude": {"field": "longitude"},
        "latitude": {"field": "latitude"},
        "text": {"field": "label"}
      }
    },

    {
      "data": {
        "values": [
          {"longitude": 111.8, "latitude": 6.8, "label": "Significantly lower doctor density,"},
          {"longitude": 99.2,  "latitude": 1.45, "label": "Highest doctor density due "},
          {"longitude": 102.9, "latitude": 6.8, "label": "Noticeably lower doctor density compared"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 400,
        "fill": "#3d4a5c",
        "baseline": "middle",
        "align": "left"
      },
      "encoding": {
        "longitude": {"field": "longitude"},
        "latitude": {"field": "latitude"},
        "text": {"field": "label"}
      }
    },

    {
      "data": {
        "values": [
          {"longitude": 111.8, "latitude": 6.5, "label": "healthcare access challenges in"},
          {"longitude": 99.2,  "latitude": 1.15, "label": "to strong urban healthcare"},
          {"longitude": 102.9, "latitude": 6.5, "label": "to central and western healthcare hubs"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 400,
        "fill": "#3d4a5c",
        "baseline": "middle",
        "align": "left"
      },
      "encoding": {
        "longitude": {"field": "longitude"},
        "latitude": {"field": "latitude"},
        "text": {"field": "label"}
      }
    },

    {
      "data": {
        "values": [
          {"longitude": 111.8, "latitude": 6.2, "label": "vast rural and remote regions"},
          {"longitude": 99.2,  "latitude": 0.85, "label": "infrastructure and resources"},
          {"longitude": 102.9, "latitude": 6.2, "label": "highlighting regional workforce disparity"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 400,
        "fill": "#3d4a5c",
        "baseline": "middle",
        "align": "left"
      },
      "encoding": {
        "longitude": {"field": "longitude"},
        "latitude": {"field": "latitude"},
        "text": {"field": "label"}
      }
    }

  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"}
  }
}