{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "comment": "New background layer to render neighboring countries (Indonesia, Thailand, Brunei)",
      "data": {
        "url": "json/neighbour.topojson",
        "format": {"type": "topojson", "feature": "selection"}
      },
      "mark": { "type": "geoshape", "fill": "#e8e8e8", "stroke": "#d0d0d0", "strokeWidth": 0.5 }
    },
    {
      "data": {
        "url": "json/neighbour.topojson",
        "format": {"type": "topojson", "feature": "malaysia.state"}
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {"url": "data/doctor_map.csv"},
            "key": "state",
            "fields": ["doctors_per_10000"]
          }
        }
      ],
      "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 1 },
      "encoding": {
        "color": {
          "field": "doctors_per_10000",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [15, 19, 23, 30, 60],
            "range": ["#d6e8f5", "#9bbfd9", "#5a96bd", "#2a6899", "#1a3a5c", "#0d1f38"]
          },
          "legend": {
            "title": "Doctors per 10,000",
            "orient": "right",
            "direction": "vertical",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "format": ".0f",
            "labelFont": "Source Sans 3, sans-serif",
            "titleFont": "Source Sans 3, sans-serif"
          }
        },
        "tooltip": [
          { "field": "properties.name", "type": "nominal", "title": "State" },
          { "field": "doctors_per_10000", "type": "quantitative", "title": "Doctors per 10,000", "format": ".1f" }
        ]
      }
    },
    {
      "data": {"url": "data/state_info.csv"},
      "mark": {
        "type": "text",
        "dy": -5,
        "fontSize": 9,
        "fontWeight": 600,
        "font": "Source Sans 3, sans-serif"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "state", "type": "nominal"},
        "color": {
          "condition": {
            "test": "datum.state === 'Kuala Lumpur' || datum.state === 'Putrajaya'",
            "value": "#c8972a"
          },
          "value": "#1a1f2e"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "font": "Source Sans 3, sans-serif"
  }
}