{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "spacing": 12,
  "hconcat": [
    {
      "title": {
        "text": "Inpatient",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "#3d4a5c"
      },
      "width": 190,
      "height": 395,
      "data": {
        "url": "data/Inpatient and Outpatient.csv"
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Number)",
          "as": "count"
        },
        {
          "calculate": "datum.Sector === 'MOH_Public' ? 'MOH Public' : datum.Sector === 'Non_MOH_Public' ? 'Non-MOH Public' : 'Private'",
          "as": "sector_label"
        },
        {
          "filter": "datum.ServiceType === 'Inpatient'"
        }
      ],
      "mark": {
        "type": "bar",
        "tooltip": true,
        "size": 32
      },
      "encoding": {
        "x": {
          "field": "sector_label",
          "type": "nominal",
          "sort": {
            "field": "count",
            "order": "descending"
          },
          "title": "Sector",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11,
            "titleFontSize": 14,
            "titleFontWeight": "normal",
            "labelFontWeight": "normal",
            "titlePadding": 8
          }
        },
        "y": {
          "field": "count",
          "type": "quantitative",
          "title": "Visits",
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 14,
            "labelFontWeight": "normal",
            "titleFontWeight": "normal",
            "titlePadding": 8,
            "labelExpr": "datum.value >= 1000000 ? format(datum.value / 1000000, '.1f') + 'M' : datum.value >= 1000 ? format(datum.value / 1000, '.0f') + 'K' : datum.value",
            "gridColor": "#eef0f3",
            "gridOpacity": 1
          }
        },
        "color": {
          "field": "sector_label",
          "type": "nominal",
          "sort": {
            "field": "count",
            "order": "descending"
          },
          "scale": {
            "domain": [
              "MOH Public",
              "Non-MOH Public",
              "Private"
            ],
            "range": [
              "#FBBF24",
              "#cbd5e1",
              "#cbd5e1"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "sector_label",
            "type": "nominal",
            "title": "Sector"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Inpatient Visits",
            "format": ","
          }
        ]
      }
    },
    {
      "title": {
        "text": "Outpatient",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "#3d4a5c"
      },
      "width": 190,
      "height": 395,
      "data": {
        "url": "data/Inpatient and Outpatient.csv"
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Number)",
          "as": "count"
        },
        {
          "calculate": "datum.Sector === 'MOH_Public' ? 'MOH Public' : datum.Sector === 'Non_MOH_Public' ? 'Non-MOH Public' : 'Private'",
          "as": "sector_label"
        },
        {
          "filter": "datum.ServiceType === 'Outpatient'"
        }
      ],
      "mark": {
        "type": "bar",
        "tooltip": true,
        "size": 32
      },
      "encoding": {
        "x": {
          "field": "sector_label",
          "type": "nominal",
          "sort": {
            "field": "count",
            "order": "descending"
          },
          "title": "Sector",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11,
            "titleFontSize": 14,
            "titleFontWeight": "normal",
            "labelFontWeight": "normal",
            "titlePadding": 8
          }
        },
        "y": {
          "field": "count",
          "type": "quantitative",
          "title": "Visits",
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 14,
            "labelFontWeight": "normal",
            "titleFontWeight": "normal",
            "titlePadding": 8,
            "labelExpr": "datum.value >= 1000000 ? format(datum.value / 1000000, '.0f') + 'M' : datum.value >= 1000 ? format(datum.value / 1000, '.0f') + 'K' : datum.value",
            "gridColor": "#eef0f3",
            "gridOpacity": 1
          }
        },
        "color": {
          "field": "sector_label",
          "type": "nominal",
          "sort": {
            "field": "count",
            "order": "descending"
          },
          "scale": {
            "domain": [
              "MOH Public",
              "Non-MOH Public",
              "Private"
            ],
            "range": [
              "#FBBF24",
              "#cbd5e1",
              "#cbd5e1"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "sector_label",
            "type": "nominal",
            "title": "Sector"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Outpatient Visits",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    }
  }
}