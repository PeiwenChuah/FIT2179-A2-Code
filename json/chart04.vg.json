          {"state": "Selangor", "lon1": 100.518843, "lat1": 3.370843, "lon2": 101.4010, "lat2": 3.3789},
          {"state": "Pulau Pinang", "lon1": 99.609136, "lat1": 5.599600, "lon2": 100.3283, "lat2": 5.3678},
