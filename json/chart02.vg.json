{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 500,
  "height": 500,
  "padding": {"top": 20, "left": 20, "right": 80, "bottom": 20},
  "autosize": {"type": "none", "contains": "padding"},

  "signals": [
    {"name": "radius", "update": "160"},
    {"name": "cx", "update": "250"},
    {"name": "cy", "update": "240"}
  ],

  "data": [
    {
      "name": "table",
      "values": [
        {"key": "Pharmacists",  "value": 0.463, "category": 0},
        {"key": "Hospital Beds","value": 0.477, "category": 0},
        {"key": "Nurses",       "value": 0.397, "category": 0},
        {"key": "Doctors",      "value": 0.299, "category": 0},
        {"key": "Dentists",     "value": 0.175, "category": 0},
        {"key": "Low Deaths",   "value": 0.459, "category": 0},
        {"key": "Pharmacists",  "value": 0.611, "category": 1},
        {"key": "Hospital Beds","value": 0.000, "category": 1},
        {"key": "Nurses",       "value": 0.236, "category": 1},
        {"key": "Doctors",      "value": 0.642, "category": 1},
        {"key": "Dentists",     "value": 0.500, "category": 1},
        {"key": "Low Deaths",   "value": 1.000, "category": 1}
      ]
    },
    {
      "name": "keys",
      "source": "table",
      "transform": [{"type": "aggregate", "groupby": ["key"]}]
    }
  ],

  "scales": [
    {
      "name": "angular",
      "type": "point",
      "range": {"signal": "[-PI, PI]"},
      "padding": 0.5,
      "domain": {"data": "table", "field": "key"}
    },
    {
      "name": "radial",
      "type": "linear",
      "range": {"signal": "[0, radius]"},
      "zero": true,
      "nice": false,
      "domain": [0, 1],
      "domainMin": 0
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [0, 1],
      "range": ["#1D9E75", "#378ADD"]
    }
  ],

  "encode": {
    "enter": {
      "x": {"value": 0},
      "y": {"value": 0}
    }
  },

  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 10},
          "y": {"value": 14},
          "text": {"value": "Healthcare Indicators: Sarawak vs Selangor"},
          "align": {"value": "left"},
          "baseline": {"value": "top"},
          "fill": {"value": "#333333"},
          "fontSize": {"value": 15},
          "fontWeight": {"value": "bold"}
        }
      }
    },
    {
      "type": "group",
      "name": "categories",
      "zindex": 1,
      "encode": {
        "enter": {
          "x": {"signal": "cx"},
          "y": {"signal": "cy"}
        }
      },
      "from": {
        "facet": {"data": "table", "name": "facet", "groupby": ["category"]}
      },
      "marks": [
        {
          "type": "line",
          "name": "category-line",
          "from": {"data": "facet"},
          "encode": {
            "enter": {
              "interpolate": {"value": "linear-closed"},
              "x": {"signal": "scale('radial', datum.value) * cos(scale('angular', datum.key))"},
              "y": {"signal": "scale('radial', datum.value) * sin(scale('angular', datum.key))"},
              "stroke": {"scale": "color", "field": "category"},
              "strokeWidth": {"value": 2},
              "fill": {"scale": "color", "field": "category"},
              "fillOpacity": {"value": 0.15}
            }
          }
        }
      ]
    },
    {
      "type": "rule",
      "name": "radial-grid",
      "from": {"data": "keys"},
      "zindex": 0,
      "encode": {
        "enter": {
          "x": {"signal": "cx"},
          "y": {"signal": "cy"},
          "x2": {"signal": "cx + radius * cos(scale('angular', datum.key))"},
          "y2": {"signal": "cy + radius * sin(scale('angular', datum.key))"},
          "stroke": {"value": "lightgray"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "name": "key-label",
      "from": {"data": "keys"},
      "zindex": 1,
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.key === 'Dentists' ? cx + (radius + 18) * cos(scale('angular', datum.key)) - 20 : cx + (radius + 18) * cos(scale('angular', datum.key))"
          },
          "y": {"signal": "cy + (radius + 18) * sin(scale('angular', datum.key))"},
          "text": {"field": "key"},
          "align": [
            {"test": "abs(scale('angular', datum.key)) > PI / 2", "value": "right"},
            {"value": "left"}
          ],
          "baseline": [
            {"test": "scale('angular', datum.key) > 0", "value": "top"},
            {"test": "scale('angular', datum.key) == 0", "value": "middle"},
            {"value": "bottom"}
          ],
          "fill": {"value": "#444444"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "bold"}
        }
      }
    },
    {
      "type": "line",
      "name": "outer-line",
      "from": {"data": "radial-grid"},
      "encode": {
        "enter": {
          "interpolate": {"value": "linear-closed"},
          "x": {"field": "x2"},
          "y": {"field": "y2"},
          "stroke": {"value": "lightgray"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 10},
          "y": {"signal": "cy + radius + 44"},
          "text": {"value": "State:"},
          "fill": {"value": "#444444"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"},
          "align": {"value": "left"},
          "baseline": {"value": "top"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 58},
          "y": {"signal": "cy + radius + 44"},
          "text": {"value": "● Sarawak"},
          "fill": {"value": "#1D9E75"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"},
          "align": {"value": "left"},
          "baseline": {"value": "top"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 152},
          "y": {"signal": "cy + radius + 44"},
          "text": {"value": "● Selangor"},
          "fill": {"value": "#378ADD"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"},
          "align": {"value": "left"},
          "baseline": {"value": "top"}
        }
      }
    }
  ]
}