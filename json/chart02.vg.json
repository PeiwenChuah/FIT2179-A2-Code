{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 500,
  "height": 500,
  "padding": 80,
  "background": "transparent",

  "data": [
    {
      "name": "raw",
      "url": "data/malaysia_state_health_radar.csv",
      "format": {"type": "csv"}
    },
    {
      "name": "filtered",
      "source": "raw",
      "transform": [
        {"type": "filter", "expr": "datum.state === 'Sarawak' || datum.state === 'Selangor'"}
      ]
    },
    {
      "name": "metrics",
      "values": [
        {"metric": "Pharmacists per 10000 population",         "label": "Pharmacists"},
        {"metric": "Hospital beds per 100000 population",      "label": "Hospital Beds"},
        {"metric": "Registered nurses per 10000 population",   "label": "Nurses"},
        {"metric": "Doctors per 10000 population",             "label": "Doctors"},
        {"metric": "Dental practitioners per 10000 population","label": "Dentists"},
        {"metric": "Deaths per 1000 population",               "label": "Deaths (inverted)"}
      ],
      "transform": [
        {"type": "window", "ops": ["rank"], "as": ["index"]},
        {"type": "formula", "expr": "datum.index - 1", "as": "index"},
        {"type": "formula", "expr": "6", "as": "total"},
        {"type": "formula", "expr": "(datum.index / datum.total) * 2 * PI", "as": "angle"},
        {"type": "formula", "expr": "datum.angle - PI / 2", "as": "angle"}
      ]
    },
    {
      "name": "joined",
      "source": "filtered",
      "transform": [
        {
          "type": "lookup",
          "from": "metrics",
          "key": "metric",
          "fields": ["metric"],
          "values": ["angle", "index", "label"]
        },
        {
          "type": "formula",
          "expr": "toNumber(datum['Normalised Value'])",
          "as": "norm"
        },
        {
          "type": "formula",
          "expr": "220 * datum.norm * cos(datum.angle)",
          "as": "x"
        },
        {
          "type": "formula",
          "expr": "220 * datum.norm * sin(datum.angle)",
          "as": "y"
        }
      ]
    },
    {
      "name": "sarawak",
      "source": "joined",
      "transform": [{"type": "filter", "expr": "datum.state === 'Sarawak'"}]
    },
    {
      "name": "selangor",
      "source": "joined",
      "transform": [{"type": "filter", "expr": "datum.state === 'Selangor'"}]
    },
    {
      "name": "grid",
      "values": [
        {"level": 0.25},
        {"level": 0.5},
        {"level": 0.75},
        {"level": 1.0}
      ]
    }
  ],

  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["Sarawak", "Selangor"],
      "range": ["#185FA5", "#EF9F27"]
    }
  ],

  "legends": [
    {
      "fill": "color",
      "orient": "bottom",
      "direction": "horizontal",
      "title": "State",
      "titleFontSize": 13,
      "labelFontSize": 12,
      "symbolSize": 120,
      "offset": 16
    }
  ],

  "title": {
    "text": "Healthcare Indicators: Sarawak vs Selangor",
    "subtitle": "Normalised scores across 6 health metrics (higher = better)",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "offset": 16,
    "dx": -80
  },

  "marks": [
    {
      "type": "rule",
      "from": {"data": "metrics"},
      "encode": {
        "enter": {
          "x": {"value": 0},
          "y": {"value": 0},
          "x2": {"signal": "220 * cos(datum.angle)"},
          "y2": {"signal": "220 * sin(datum.angle)"},
          "stroke": {"value": "#ccc"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "group",
      "from": {"data": "grid"},
      "marks": [
        {
          "type": "line",
          "from": {"data": "metrics"},
          "encode": {
            "enter": {
              "x": {"signal": "parent.level * 220 * cos(datum.angle)"},
              "y": {"signal": "parent.level * 220 * sin(datum.angle)"},
              "stroke": {"value": "#ddd"},
              "strokeWidth": {"value": 0.8},
              "strokeDash": {"value": [3, 3]}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "enter": {
              "x": {"value": 4},
              "y": {"signal": "-parent.level * 220"},
              "text": {"signal": "format(parent.level * 100, '.0f') + '%'"},
              "fontSize": {"value": 10},
              "fill": {"value": "#aaa"},
              "baseline": {"value": "middle"}
            }
          }
        }
      ]
    },
    {
      "type": "line",
      "from": {"data": "sarawak"},
      "transform": [
        {"type": "collect", "sort": {"field": "index"}}
      ],
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "stroke": {"value": "#185FA5"},
          "strokeWidth": {"value": 2},
          "fill": {"value": "#185FA5"},
          "fillOpacity": {"value": 0.15}
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "selangor"},
      "transform": [
        {"type": "collect", "sort": {"field": "index"}}
      ],
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "stroke": {"value": "#EF9F27"},
          "strokeWidth": {"value": 2},
          "fill": {"value": "#EF9F27"},
          "fillOpacity": {"value": 0.15}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "sarawak"},
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "size": {"value": 50},
          "fill": {"value": "#185FA5"}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "selangor"},
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "size": {"value": 50},
          "fill": {"value": "#EF9F27"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "metrics"},
      "encode": {
        "enter": {
          "x": {"signal": "235 * cos(datum.angle)"},
          "y": {"signal": "235 * sin(datum.angle)"},
          "text": {"field": "label"},
          "align": {"signal": "cos(datum.angle) > 0.1 ? 'left' : cos(datum.angle) < -0.1 ? 'right' : 'center'"},
          "baseline": {"signal": "sin(datum.angle) > 0.1 ? 'top' : sin(datum.angle) < -0.1 ? 'bottom' : 'middle'"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "500"},
          "fill": {"value": "#444"}
        }
      }
    }
  ]
}