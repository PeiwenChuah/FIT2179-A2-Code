        {"state":"Terengganu","key":"Deaths","value":0.459459459}
      ]
    },
    {
      "name": "tableA",
      "source": "raw",
      "transform": [
        {"type": "filter", "expr": "datum.state === stateA"},
        {"type": "formula", "as": "category", "expr": "0"}
      ]
    },
    {
      "name": "tableB",
      "source": "raw",
      "transform": [
        {"type": "filter", "expr": "datum.state === stateB"},
        {"type": "formula", "as": "category", "expr": "1"}
      ]
    },
    {
      "name": "table",
      "source": ["tableA", "tableB"]
    },
    {
      "name": "keys",
      "source": "table",
      "transform": [{"type": "aggregate", "groupby": ["key"]}]
    }
  ],

  "scales": [
    {
      "name": "angular",
      "type": "point",
      "range": {"signal": "[-PI, PI]"},
      "padding": 0.5,
      "domain": {"data": "table", "field": "key"}
    },
    {
      "name": "radial",
      "type": "linear",
      "range": {"signal": "[0, radius]"},
      "zero": true,
      "nice": false,
      "domain": [0, 1],
      "domainMin": 0
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [0, 1],
      "range": ["#c8972a", "#1a3a5c"]
    }
  ],

  "encode": {"enter": {"x": {"value": 0}, "y": {"value": 0}}},

  "marks": [
    {
      "type": "group",
      "zindex": 1,
      "encode": {"enter": {"x": {"signal": "cx"}, "y": {"signal": "cy"}}},
      "from": {"facet": {"data": "table", "name": "facet", "groupby": ["category"]}},
      "marks": [{
        "type": "line",
        "from": {"data": "facet"},
        "encode": {
          "enter": {
            "interpolate": {"value": "linear-closed"},
            "x": {"signal": "scale('radial', datum.value) * cos(scale('angular', datum.key))"},
            "y": {"signal": "scale('radial', datum.value) * sin(scale('angular', datum.key))"},
            "stroke": {"scale": "color", "field": "category"},
            "strokeWidth": {"value": 2.5},
            "fill": {"scale": "color", "field": "category"},
            "fillOpacity": {"value": 0.12}
          }
        }
      }]
    },
    {
      "type": "rule",
      "name": "radial-grid",
      "from": {"data": "keys"},
      "zindex": 0,
      "encode": {
        "enter": {
          "x": {"signal": "cx"}, "y": {"signal": "cy"},
          "x2": {"signal": "cx + radius * cos(scale('angular', datum.key))"},
          "y2": {"signal": "cy + radius * sin(scale('angular', datum.key))"},
          "stroke": {"value": "#dde2ea"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "line",
      "name": "outer-line",
      "from": {"data": "radial-grid"},
      "encode": {
        "enter": {
          "interpolate": {"value": "linear-closed"},
          "x": {"field": "x2"}, "y": {"field": "y2"},
          "stroke": {"value": "#dde2ea"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "name": "key-label",
      "from": {"data": "keys"},
      "zindex": 1,
      "encode": {
        "enter": {
          "x": {"signal": "cx + (radius + 20) * cos(scale('angular', datum.key))"},
          "y": {"signal": "cy + (radius + 20) * sin(scale('angular', datum.key))"},
          "text": {"field": "key"},
          "align": [
            {"test": "abs(scale('angular', datum.key)) > PI / 2", "value": "right"},
            {"value": "left"}
          ],
          "baseline": [
            {"test": "scale('angular', datum.key) > 0.3", "value": "top"},
            {"test": "scale('angular', datum.key) < -0.3", "value": "bottom"},
            {"value": "middle"}
          ],
          "fill": {"value": "#3d4a5c"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": "600"},
          "font": {"value": "Source Sans 3, sans-serif"}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "table"},
      "zindex": 2,
      "encode": {
        "enter": {
          "x": {"signal": "cx + scale('radial', datum.value) * cos(scale('angular', datum.key))"},
          "y": {"signal": "cy + scale('radial', datum.value) * sin(scale('angular', datum.key))"},
          "size": {"value": 36},
          "fill": {"scale": "color", "field": "category"},
          "opacity": {"value": 0.9},
          "tooltip": {"signal": "{'State': datum.state, 'Metric': datum.key, 'Normalised score': format(datum.value, '.3f')}"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 8}, "y": {"signal": "cy + radius + 36"},
          "text": {"value": "State:"},
          "fill": {"value": "#3d4a5c"},
          "fontSize": {"value": 11}, "fontWeight": {"value": "bold"},
          "font": {"value": "Source Sans 3, sans-serif"},
          "align": {"value": "left"}, "baseline": {"value": "top"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 52}, "y": {"signal": "cy + radius + 36"},
          "text": {"signal": "'● ' + stateA"},
          "fill": {"value": "#c8972a"},
          "fontSize": {"value": 11}, "fontWeight": {"value": "bold"},
          "font": {"value": "Source Sans 3, sans-serif"},
          "align": {"value": "left"}, "baseline": {"value": "top"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 182}, "y": {"signal": "cy + radius + 36"},
          "text": {"signal": "'● ' + stateB"},
          "fill": {"value": "#1a3a5c"},
          "fontSize": {"value": 11}, "fontWeight": {"value": "bold"},
          "font": {"value": "Source Sans 3, sans-serif"},
          "align": {"value": "left"}, "baseline": {"value": "top"}
        }
      }
    }
  ]
}