    },
    {
      "name": "tableA",
      "source": "raw",
      "transform": [
        {"type": "filter", "expr": "datum.state === stateA"},
        {"type": "formula", "as": "category", "expr": "0"}
      ]
    },
    {
      "name": "tableB",
      "source": "raw",
      "transform": [
        {"type": "filter", "expr": "datum.state === stateB"},
        {"type": "formula", "as": "category", "expr": "1"}
      ]
    },
    {
      "name": "table",
      "source": ["tableA", "tableB"]
    },
    {
      "name": "keys",
      "source": "table",
      "transform": [{"type": "aggregate", "groupby": ["key"]}]
    }
  ],

  "scales": [
    {
      "name": "angular",
      "type": "point",
      "range": {"signal": "[-PI, PI]"},
      "padding": 0.5,
      "domain": {"data": "table", "field": "key"}
    },
    {
      "name": "radial",
      "type": "linear",
      "range": {"signal": "[0, 105]"},
      "zero": true,
      "nice": false,
      "domain": [0, 1],
      "domainMin": 0
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [0, 1],
      "range": ["#c8972a", "#1a3a5c"]
    }
  ],

  "encode": {
    "enter": {
      "x": {"signal": "width/2"},
      "y": {"signal": "height/2 -80"}
    }
  },

  "marks": [
    {
      "type": "group",
      "name": "chart-group",
      "zindex": 1,
      "from": {"facet": {"data": "table", "name": "facet", "groupby": ["category"]}},
      "marks": [{
        "type": "line",
        "from": {"data": "facet"},
        "encode": {
          "enter": {
            "interpolate": {"value": "linear-closed"},
            "x": {"signal": "scale('radial', datum.value) * cos(scale('angular', datum.key))"},
            "y": {"signal": "scale('radial', datum.value) * sin(scale('angular', datum.key))"},
            "stroke": {"scale": "color", "field": "category"},
            "strokeWidth": {"value": 2.5},
            "fill": {"scale": "color", "field": "category"},
            "fillOpacity": {"value": 0.12}
          }
        }
      }]
    },
    {
      "type": "rule",
      "name": "radial-grid",
      "from": {"data": "keys"},
      "zindex": 0,
      "encode": {
        "enter": {
          "x": {"value": 0}, "y": {"value": 0},
          "x2": {"signal": "105 * cos(scale('angular', datum.key))"},
          "y2": {"signal": "105 * sin(scale('angular', datum.key))"},
          "stroke": {"value": "#dde2ea"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "line",
      "name": "outer-line",
      "from": {"data": "radial-grid"},
      "encode": {
        "enter": {
          "interpolate": {"value": "linear-closed"},
          "x": {"field": "x2"}, "y": {"field": "y2"},
          "stroke": {"value": "#dde2ea"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
  "type": "text",
  "name": "key-label",
  "from": {"data": "keys"},
  "zindex": 1,

  "encode": {
    "enter": {

      "x": {
        "signal": "(datum.key === 'Hospital Beds' ? -36 : datum.key === 'Dentists' ? -25 : 0) + (105 + 18) * cos(scale('angular', datum.key))"
      },

      "y": {
        "signal": "(105 + 18) * sin(scale('angular', datum.key))"
      },

      "text": {
        "field": "key"
      },

      "align": [
        {
          "test": "abs(scale('angular', datum.key)) > PI / 2",
          "value": "right"
        },
        {
          "value": "left"
        }
      ],

      "baseline": [
        {
          "test": "scale('angular', datum.key) > 0.3",
          "value": "top"
        },
        {
          "test": "scale('angular', datum.key) < -0.3",
          "value": "bottom"
        },
        {
          "value": "middle"
        }
      ],

      "fill": {
        "value": "black"
      },

      "fontSize": {
        "value": 14
      },

      "fontWeight": {
        "value": "normal"
      }
    }
  }
},
    {
      "type": "symbol",
      "from": {"data": "table"},
      "zindex": 2,
      "encode": {
        "enter": {
          "x": {"signal": "scale('radial', datum.value) * cos(scale('angular', datum.key))"},
          "y": {"signal": "scale('radial', datum.value) * sin(scale('angular', datum.key))"},
          "size": {"value": 36},
          "fill": {"scale": "color", "field": "category"},
          "opacity": {"value": 0.9},
          "tooltip": {"signal": "{'State': datum.state, 'Metric': datum.key, 'Index': format(datum.value, '.3f')}"}
        }
      }
    }
  ]
}