        "name": "State 1: ",
        "options": ["Johor","Kedah","Kelantan","Melaka","Negeri Sembilan","Pahang","Perak","Perlis","Pulau Pinang","Sabah","Sarawak","Selangor","Terengganu"]
      }
    },
    {
      "name": "stateB",
      "value": "Selangor",
      "bind": {
        "input": "select",
        "name": "State 2: ",
        "options": ["Johor","Kedah","Kelantan","Melaka","Negeri Sembilan","Pahang","Perak","Perlis","Pulau Pinang","Sabah","Sarawak","Selangor","Terengganu"]
      }
    }
  ],

