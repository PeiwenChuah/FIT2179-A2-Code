{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 340,

  "data": {
    "url": "data/birth_death.csv"
  },

  "layer": [

    {
      "mark": {
        "type": "line",
        "point": true
      },

      "encoding": {

        "x": {
          "field": "Date",
          "type": "temporal",

          "axis": {
            "titleFontSize": 14,
            "labelFontSize": 12
          }
        },

        "y": {
          "field": "Rate",
          "type": "quantitative",
          "title": "Cases per 1,000 population",

          "axis": {
            "titleFontSize": 14,
            "labelFontSize": 12
          }
        },

        "color": {
          "field": "Type",
          "type": "nominal",

          "legend": {
            "titleFontSize": 14,
            "labelFontSize": 12,
            
            "symbolSize": 100,

            "titleFontWeight": "normal",
            "labelFontWeight": "normal"
          }
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Date": "2020-01-01"
          }
        ]
      },

      "mark": {
        "type": "rule",
        "color": "#7a2e0e",
        "strokeWidth": 2,
        "strokeDash": [6, 6]
      },

      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Date": "2020-01-01",
            "Rate": 10,
            "label": "COVID-19 onset"
          }
        ]
      },

      "mark": {
        "type": "text",
        "dy": -20,
        "color": "#7a2e0e"
      },

      "encoding": {

        "x": {
          "field": "Date",
          "type": "temporal"
        },

        "y": {
          "field": "Rate",
          "type": "quantitative"
        },

        "text": {
          "field": "label"
        },

        "size": {
          "value": 14
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Date": "2020-01-01",
            "Rate": 9,
            "label": "Death rate spiked in 2020"
          }
        ]
      },

      "mark": {
        "type": "text",
        "dy": 20,
        "color": "#7a2e0e"
      },

      "encoding": {

        "x": {
          "field": "Date",
          "type": "temporal"
        },

        "y": {
          "field": "Rate",
          "type": "quantitative"
        },

        "text": {
          "field": "label"
        },

        "size": {
          "value": 14
        }
      }
    }

  ]
}