{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Doctors per 10,000 Population by State, Malaysia",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": 800,
  "height": 450,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "json/state.topojson",
        "format": {"type": "topojson", "feature": "adjusted_map"}
      },
      "transform": [
        {
          "lookup": "properties.NAME_1",
          "from": {
            "data": {"url": "data/doctor_map.csv"},
            "key": "state",
            "fields": ["doctors_per_10000"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "doctors_per_10000",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "domain": [12, 20, 23, 600],
            "scheme": "blues"
          },
          "legend": {
            "title": "Doctors per 10,000",
            "orient": "bottom-right",
            "direction": "vertical",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME_1",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "doctors_per_10000",
            "type": "quantitative",
            "title": "Doctors per 10,000",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {"url": "data/state_info.csv"},
      "mark": {"type": "text", "dy": -5, "fontSize": 8},
      "encoding": {
        "longitude": {"field": "longitude"},
        "latitude": {"field": "latitude"},
        "text": {"field": "state"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    },
    "line": {
      "strokeWidth": 2
    },
    "point": {
      "filled": true,
      "size": 60
    },
    "font": "system-ui, -apple-system, sans-serif"
  }
}
