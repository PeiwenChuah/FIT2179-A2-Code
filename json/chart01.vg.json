{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "padding": {
    "right": 15
  },
  "data": {
    "url": "data/birth_death.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          4
        ],
        "stroke": "#7F1D1D",
        "strokeWidth": 1.5,
        "opacity": 0.55
      },
      "data": {
        "values": [
          {
            "x": "2020-01-01"
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "temporal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 13,
        "fontWeight": "normal",
        "color": "#7F1D1D"
      },
      "data": {
        "values": [
          {
            "x": "2020-01-01",
            "y": 9.5,
            "label": "COVID-19 onset"
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "temporal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 13,
        "fontWeight": "normal",
        "color": "#7F1D1D"
      },
      "data": {
        "values": [
          {
            "x": "2020-01-01",
            "y": 8.4,
            "label": "Death rate spiked"
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "temporal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "point": {
          "size": 50,
          "filled": true
        },
        "strokeWidth": 2.5,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 14,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "grid": false
          }
        },
        "y": {
          "field": "Rate",
          "type": "quantitative",
          "title": "Cases per 1,000 population",
          "scale": {
            "domain": [0, 26]
          },
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 14,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "gridColor": "#eef0f3",
            "gridOpacity": 1,
            "format": ".1f"
          }
        },
        "color": {
          "field": "Type",
          "type": "nominal",
          "title": "Indicator",
          "scale": {
            "domain": [
              "Birth",
              "Death"
            ],
            "range": [
              "#0EA5A4",
              "#7F1D1D"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 15,
            "legendY": 5,
            "direction": "horizontal",
            "titleFontSize": 14,
            "labelFontSize": 14,
            "symbolSize": 100,
            "titleFontWeight": "bold",
            "labelFontWeight": "normal",
            "padding": 0
          }
        },
        "tooltip": [
          {
            "field": "Date",
            "type": "temporal",
            "title": "Year"
          },
          {
            "field": "Type",
            "type": "nominal",
            "title": "Indicator"
          },
          {
            "field": "Rate",
            "type": "quantitative",
            "title": "Rate",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domainColor": "#ccc",
      "tickColor": "#ccc"
    }
  }
}