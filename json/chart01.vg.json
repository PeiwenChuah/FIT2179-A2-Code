{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 340,
  "padding": {"right": 20},

  "data": {
    "url": "data/birth_death.csv"
  },

  "layer": [

    {
      "mark": {
        "type": "rule",
        "strokeDash": [5, 4],
        "stroke": "#7a2e0e",
        "strokeWidth": 1.5,
        "opacity": 0.55
      },
      "data": {
        "values": [ { "x": "2020-01-01" } ]
      },
      "encoding": {
        "x": { "field": "x", "type": "temporal" }
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 10,
        "fontWeight": 600,
        "fontStyle": "italic",
        "color": "#7a2e0e",
        "font": "Source Sans 3, sans-serif"
      },
      "data": {
        "values": [ { "x": "2020-01-01", "y": 9.5, "label": "COVID-19 onset" } ]
      },
      "encoding": {
        "x": { "field": "x", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative" },
        "text": { "field": "label" }
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 15,
        "color": "#7a2e0e",
        "font": "Source Sans 3, sans-serif",
        "fontStyle": "italic"
      },
      "data": {
        "values": [ { "x": "2020-01-01", "y": 8.4, "label": "Death rate spiked in 2020" } ]
      },
      "encoding": {
        "x": { "field": "x", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative" },
        "text": { "field": "label" }
      }
    },

    {
      "mark": {
        "type": "line",
        "point": { "size": 50, "filled": true },
        "strokeWidth": 2.5,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "grid": false,
            "labelFont": "Source Sans 3, sans-serif",
            "titleFont": "Source Sans 3, sans-serif"
          }
        },
        "y": {
          "field": "Rate",
          "type": "quantitative",
          "title": "Cases per 1,000 population",
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "gridColor": "#eef0f3",
            "gridOpacity": 1,
            "format": ".1f",
            "labelFont": "Source Sans 3, sans-serif",
            "titleFont": "Source Sans 3, sans-serif"
          }
        },
        "color": {
          "field": "Type",
          "type": "nominal",
          "title": "Indicator",
          "scale": {
            "domain": ["Birth", "Death"],
            "range": ["#3a7fc1", "#7a2e0e"]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 15,
            "labelFontSize": 15,
            "symbolSize": 100,
            "offset": 0,
            "padding": 0,
            "legendX": 0,
            "legendY": 80,
            "labelFont": "Source Sans 3, sans-serif",
            "titleFont": "Source Sans 3, sans-serif"
          }
        },
        "tooltip": [
          { "field": "Date", "type": "temporal", "title": "Year" },
          { "field": "Type", "type": "nominal", "title": "Indicator" },
          { "field": "Rate", "type": "quantitative", "title": "Rate", "format": ".1f" }
        ]
      }
    }

  ],

  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": { "domainColor": "#ccc", "tickColor": "#ccc" },
    "font": "Source Sans 3, sans-serif"
  }
}